# Azure DevOps Configuration
# IMPORTANTE: Nunca commitear este archivo a git
# Copiar este archivo a .env.local y completar con tus valores

# Tu Personal Access Token de Azure DevOps
# Obtener en: https://dev.azure.com/cinemarkintl/_usersSettings/tokens
AZURE_PAT=tu_token_aqui

# Organización de Azure DevOps
AZURE_ORG=cinemarkintl

# Proyecto por defecto
AZURE_PROJECT=Core Backend

# Área por defecto (opcional)
AZURE_AREA=Core Backend

# Usuario asignado (tu email de Azure DevOps)
AZURE_USER=tu.email@cinemark.com
